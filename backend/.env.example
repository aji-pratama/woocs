# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (matches compose.dev.yml)
DB_NAME=woocs
DB_USER=woocs
DB_PASSWORD=woocs_dev
DB_HOST=localhost
DB_PORT=5432

# AI providers
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
AI_CHAT_MODEL=claude-haiku
AI_EMBEDDING_MODEL=openai-catalog

# Polar billing (use sandbox values in development)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_API_URL=https://sandbox-api.polar.sh/v1
POLAR_SUCCESS_URL=http://localhost:5173/billing/success
# JSON map from internal plan keys to Polar product IDs
POLAR_PRODUCTS={"starter":"","growth":"","pro":""}
