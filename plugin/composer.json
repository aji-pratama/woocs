{
    "name": "woocs/woocs-ai",
    "description": "WooCS AI WordPress Plugin",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "WooCS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WooCS\\Tests\\": "tests/"
        }
    }
}
