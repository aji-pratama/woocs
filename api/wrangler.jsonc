{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "woocs",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "AI_CHAT_MODEL": "nex-agi/nex-n2.5-mini:free",
    "AI_CHAT_MODELS": "nex-agi/nex-n2.5-mini:free,meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-small-24b-instruct-2501:free,google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-coder-32b-instruct:free",
    "AI_EMBEDDING_MODEL": "liquid/lfm-2.5-embedding-350m:free",
    "AI_MOCK_MODE": false,
    "HEALTH_CHECK_PATH": "/api/internal/health-check-9x7f2k",
    "NODE_ENV": "production",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "POLAR_API_URL": "https://api.polar.sh",
    "POLAR_PRO_PRODUCT_ID": "prod_placeholder"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
}