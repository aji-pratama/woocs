# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=8001
APP_URL=http://localhost:8001
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# Default config using local Docker compose (port 5432 or 5435 depending on setup)
DATABASE_URL=postgres://woocs:woocs_dev@127.0.0.1:5432/woocs

# ─── LLM Providers & Parsing ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLAMAPARSE_API_KEY=llx-...

# ─── Billing (Polar) ───────────────────────────────────────────────────────────
POLAR_API_URL=https://api.polar.sh
POLAR_ACCESS_TOKEN=polar_at_...
POLAR_WEBHOOK_SECRET=polar_wh_...
POLAR_PRO_PRODUCT_ID=prod_...
POLAR_PRODUCTS={"pro":"prod_..."}
POLAR_SUCCESS_URL=http://localhost:8080/wp-admin/admin.php?page=woocs-settings&checkout=success